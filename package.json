{
  "name": "norafu-art",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && gh-pages -d dist -b main --dotfiles",
    "artwork:prepare": "node scripts/prepare-pending-artwork.mjs",
