---
import { getCollection } from 'astro:content';

interface Props {
  activePage: 'gallery' | 'about';
  activeYear?: number | null;
  locale?: 'en' | 'zh';
}

const { activePage, activeYear = null, locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;

const entries = await getCollection('artworks');
const years = [...new Set(entries.map((e) => e.data.year))].sort((a, b) => b - a);

const localePath = locale === 'zh' ? `${base}zh/` : base;

// Compute alternate-locale URL from the current build-time pathname
const path = Astro.url.pathname;
const withoutBase = path.startsWith(base) ? path.slice(base.length) : path.replace(/^\//, '');
const pagePart = withoutBase.startsWith('zh/') ? withoutBase.slice(3) : withoutBase;
const cleanPage = pagePart.replace(/\/$/, '');
const enUrl = `${base}${cleanPage}`;
const zhUrl = `${base}zh/${cleanPage}`;
---

<nav class="navbar">
  <a class="navbar-brand" href={localePath}>
    <span style="font-size: 2rem">Nora Fu's Art</span><br />
    <span style="font-size: 1.5rem">瓜 瓜 的 画</span>
  </a>

  <div class="navbar-menu">
    <a href={localePath} class={activePage === 'gallery' && activeYear === null ? 'active' : ''}>
      {locale === 'zh' ? '画廊' : 'Gallery'}
    </a>

    <div class="year-filter">
      <a href={localePath} class={activePage === 'gallery' && activeYear === null ? 'active' : ''}>
        {locale === 'zh' ? '所有年份' : 'All Years'}
      </a>
      {years.map((year) => (
        <a
          href={`${localePath}year/${year}`}
          class={activeYear === year ? 'active' : ''}
        >
          {year}
        </a>
      ))}
    </div>

    <a href={`${localePath}about`} class={activePage === 'about' ? 'active' : ''}>
      {locale === 'zh' ? '关于' : 'About'}
    </a>

    <div class="lang-switcher">
      <a href={enUrl} class={locale === 'en' ? 'active' : ''}>EN</a>
      <span aria-hidden="true">|</span>
      <a href={zhUrl} class={locale === 'zh' ? 'active' : ''}>中文</a>
    </div>
  </div>
</nav>

<style>
  .lang-switcher {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    margin-left: 0.5rem;
  }
  .lang-switcher a {
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .lang-switcher a:hover,
  .lang-switcher a.active {
    opacity: 1;
    font-weight: 600;
  }
  .lang-switcher span {
    opacity: 0.3;
  }
</style>
